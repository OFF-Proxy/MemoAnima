{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MemoAnima",
  "mainBinaryName": "MemoAnima",
  "version": "1.4.1",
  "identifier": "com.arcana.memoanima",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "メモアニマ (MemoAnima)",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://memoanima.com/updates/latest.json",
        "https://github.com/OFF-Proxy/MemoAnima/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlEQjYzMzYwRjZDMUMxQzAKUldUQXdjSDJZRE8yblV5MzBrZ2xGUEJ0TWI5SUtxd3BQSDgxMlhCYkZjQkZvL3hVYlhBcUJMMTIK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
